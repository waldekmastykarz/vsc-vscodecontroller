{
  "name": "vscode-controller",
  "displayName": "VS Code Controller",
  "description": "Drive VS Code and GitHub Copilot Chat from scripts, tests and agents over a local JSON-RPC socket",
  "version": "0.1.0",
  "publisher": "waldek",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/waldekmastykarz/vsc-vscodecontroller.git"
  },
  "bugs": {
    "url": "https://github.com/waldekmastykarz/vsc-vscodecontroller/issues"
  },
  "homepage": "https://github.com/waldekmastykarz/vsc-vscodecontroller#readme",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Testing",
    "Other"
  ],
  "keywords": [
    "copilot",
    "github copilot",
    "automation",
    "json-rpc",
    "remote control",
    "agent",
    "evaluation",
    "mcp",
    "testing"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "test": "npm run build && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.140.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
